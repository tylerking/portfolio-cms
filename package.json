{
	"name": "portfolio-cms",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "tsx scripts/seed.ts",
		"set-password": "tsx scripts/set-password.ts",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"knip": "knip",
		"dup": "jscpd src tests --ignore-pattern 'import .* from'",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm build && playwright test",
		"verify": "pnpm lint && pnpm check && pnpm knip && pnpm dup && pnpm test:coverage && pnpm test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "2.5.13",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"@vanilla-extract/css": "^1.21.2",
		"@vanilla-extract/recipes": "^0.5.7",
		"@vanilla-extract/vite-plugin": "^5.2.6",
		"@vitest/coverage-v8": "^5.0.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"jscpd": "^5.2.0",
		"jsdom": "^30.0.1",
		"knip": "^6.35.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@netlify/blobs": "^11.0.3",
		"@netlify/functions": "^6.0.0",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.23.0",
		"zod": "^4.6.2"
	}
}
